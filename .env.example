# Lock & Deploy bank-link prototype. Copy to .env (never commit .env).
# SANDBOX ONLY. There is no setting that enables real money; see README "Production guard".

# Which provider adapter to use: "mock" (default, offline, no keys) or "plaid-sandbox".
PROVIDER=mock

# Local server. Keep HOST on 127.0.0.1. The app has a passcode login, but it is a single-user local tool, not an internet service.
HOST=127.0.0.1
PORT=5180

# Where the JSON data file (db.json) lives. Git-ignored.
DATA_DIR=./data

# 32 random bytes, base64. Encrypts provider access tokens at rest (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# If empty, a local dev key is created at DATA_DIR/.dev-token-key (fine for sandbox, not for real use).
TOKEN_ENCRYPTION_KEY=

# How often the scheduler checks for due pulls and syncs transfer statuses (seconds, min 5).
SCHEDULER_INTERVAL_SECONDS=60

# Sandbox demo clock (+1/+7/+30 day buttons). 1 = on, 0 = off.
DEMO_CLOCK=1

# Optional: pin the simulated "today" (YYYY-MM-DD) for demos/tests. The demo clock advances from here.
SIM_DATE=

# ---- Notifications (console + in-app are always on; see config/default-settings.json) ----
# Optional webhook notifier: POSTs JSON events here, signed with HMAC-SHA256 in the X-LDB-Signature header.
# Unlock codes, passcodes, tokens and bot keys are never included in any notification.
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_SECRET=

# ---- Plaid Sandbox (only read when PROVIDER=plaid-sandbox) ----
# From https://dashboard.plaid.com/developers/keys : the SANDBOX secret. Server-side only.
PLAID_CLIENT_ID=
PLAID_SECRET=
# Must be exactly "sandbox". Any other value refuses startup. The API host is hard-coded to https://sandbox.plaid.com.
PLAID_ENV=sandbox
# Optional public HTTPS URL that forwards to http://127.0.0.1:5180/api/webhooks/plaid-sandbox (e.g. a tunnel).
# Without it, statuses are still synced by polling /transfer/event/sync on every scheduler tick.
PLAID_WEBHOOK_URL=
# Verify the Plaid-Verification JWT on incoming webhooks (1 = yes). Leave on.
PLAID_VERIFY_WEBHOOKS=1
# Name sent as user.legal_name on /transfer/authorization/create (sandbox). The authorization signer name is used when present.
PLAID_LEGAL_NAME=Sandbox Tester

# ---- Deliberately NOT supported ----
# Setting any of these refuses startup: ALLOW_PRODUCTION, ENABLE_PRODUCTION, ENABLE_REAL_MONEY, REAL_MONEY, LIVE_MODE, PRODUCTION.
# NODE_ENV=production, PLAID_ENV other than sandbox, and any STRIPE_* live key (sk_live_/rk_live_/pk_live_) also refuse startup.
