            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GoalProposal"
              }
            }
          }
        }
      }
    },
    "/bot/v1/rollovers/prepare": {
      "post": {
        "summary": "Prepare a Roll Over & Relock (needs user approval)",
        "description": "Returns the preview calculation (vault, withdraw, remaining, new goal, additional needed) and creates a pending `rollover` approval. If it withdraws, the user must also enter the unlock code. While the vault is locked only `raise` can be prepared (423).\n\nRequired scope: `propose`.",
        "security": [
          {
            "botKey": [
              "propose"
            ]
          }
        ],
        "x-scope": "propose",
        "responses": {
          "202": {
            "description": "Preview + approval created",
