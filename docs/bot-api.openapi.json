{
  "openapi": "3.0.3",
  "info": {
    "title": "Lock & Deploy Bot API",
    "version": "1.0.0-sandbox",
    "description": "API for an AI assistant that monitors and manages the Lock & Deploy savings vault (SANDBOX ONLY).\n\n* Auth: `Authorization: Bearer ldbk_<id>.<secret>` (created by the user in the app, shown once, stored hashed, revocable, scoped).\n* Every call, including refused ones, is logged to the in-app Bot activity log and the hash-chained audit log.\n* Rate limit: per key, `settings.bot.rateLimitPerMinute` (default 30/min); 10 failed auths per minute per IP.\n* Direct actions: read, and pause future deposits. Sensitive actions become pending approvals (HTTP 202) that execute only after the user approves in the app, with the unlock code for anything that withdraws.\n* Never available to a bot: bank credentials or provider tokens, unlocking or bypassing the Hard Lock, hardship release, loosening a locked goal, emergency controls, switching to production, deleting or editing audit entries or transactions. There are no DELETE/PUT/PATCH operations (405).\n* Seal my login: a bot sees only that a sealed login exists (label, sealedAt, status). It can never reveal, create, delete, reseal it or change its unlock date (403, logged).\n* Did you know? cards: readable via /bot/v1/cards (no amounts while Go Blind is on). /bot/v1/speed-up/propose asks the user to raise the deposit (approval + new authorization)."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:5180",
      "description": "Local (loopback only)"
    }
  ],
  "components": {
    "securitySchemes": {
      "botKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "ldbk_<16 hex id>.<43 char secret>"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Approval": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "payload": {
            "type": "object"
          },
          "summary": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "rejected",
              "expired",
              "cancelled",
              "failed"
            ]
          },
          "requiresUnlockCode": {
            "type": "boolean"
          },
          "expiresOn": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "GoalProposal": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 60
          },
          "targetCents": {
            "type": "integer",
            "description": "US cents"
          },
          "releaseDate": {
            "type": "string",
            "format": "date"
          },
          "milestonesCents": {
            "type": "array",
            "items": {
              "type": "integer",
              "description": "US cents"
            }
          },
          "reason": {
            "type": "string"
          }
        },
        "description": "While the goal is locked, only raises and later release dates are accepted (403 lock_loosening_blocked otherwise). hardLock/hardship/unlockRule are user-only (403)."
      },
      "RolloverPrepare": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "partial",
              "full",
              "raise"
            ]
          },
          "withdrawCents": {
            "type": "integer",
            "description": "US cents"
          },
          "newTargetCents": {
            "type": "integer",
            "description": "US cents"
          },
          "milestonesCents": {
            "type": "array",
            "items": {
              "type": "integer",
              "description": "US cents"
            }
          },
          "fullAction": {
            "type": "string",
            "enum": [
              "close",
              "restart"
            ]
          }
        },
        "example": {
          "mode": "partial",
          "withdrawCents": 100000,
          "newTargetCents": 400000
        }
      },
      "Request": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "resume_schedule",
              "schedule_change",
              "change_funding_account",
              "revoke_authorization",
              "grant_authorization",
              "settings_change",
              "withdrawal"
            ]
          },
          "payload": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        },
        "description": "Forbidden types return 403 forbidden_for_bot: unlock, early_unlock, bypass_lock, hardship_release, disable_hard_lock, lower_goal, switch_production, enable_real_money, disable_emergency, disable_emergency_stop, delete_audit, edit_audit, hide_transaction, delete_transaction, read_tokens, read_credentials, create_bot_key, raise_rate_limit_self. Also refused: blind_off, disable_blind, turn_off_blind, remove_stay_blind, reveal_amounts, show_amounts, read_hidden_amounts, and every sealed-login type (reveal_sealed_login, reveal_login, reveal_password, show_password, read_sealed_login, unseal, unseal_login, create_sealed_login, seal_login, delete_sealed_login, reseal_login, change_unlock_date, earlier_unlock_date)."
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing, invalid or revoked bot key",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Insufficient scope, or an action bots can never take",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "RateLimited": {
        "description": "Rate limit exceeded",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/bot/v1/status": {
      "get": {
        "summary": "Balances, goal, schedule, pending approvals",
        "description": "Settled (locked) and pending balances are reported separately. Only settled deposits count toward the goal.\n\nRequired scope: `read`. Includes `sealedLogins` (label, status, sealedAt only).",
        "security": [
          {
            "botKey": [
              "read"
            ]
          }
        ],
        "x-scope": "read",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
